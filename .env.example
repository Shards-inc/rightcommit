# Published local port (the container listens on 8080).
RIGHTCOMMIT_PORT=8080

# Read PROVIDER_TERMS.md before sharing organizational API access.
# Optional provider environment. Copy to .env, chmod 600 .env, fill only what you use.
# Native startup reads .env from the current working directory automatically.
# Variables already present in the process environment take precedence.
# Empty entries are left unset, preserving native defaults such as system CA certificates.
# Credentials: API keys, authorized gateways and cloud provider configuration.
# Credential file paths below must exist and be readable INSIDE the container.
