# rightcommit configuration example
# Copy this file to .env, chmod 600 .env, then fill only the settings you use.
# Keep .env private. Empty optional entries preserve native/provider defaults.
# Native/Homebrew: rightcommit reads .env from the directory where you run it,
# not from the binary installation directory or any parent directory. Restart the
# app after edits; variables already exported in the process take precedence.
# Docker Compose forwards only variables explicitly mapped in its environment block.
# The NODO_ names below are existing configuration names retained for compatibility.

# ============================================================================
# Application access and local server
# ============================================================================
# Docker Compose reads this file after you copy it to .env.
# Apply changes with docker compose up -d (no rebuild needed for these settings).
# For the test instance: docker compose -f compose.itsm-test.yaml up -d rightcommit-test.
# RIGHTCOMMIT_PORT is Docker-only: the published local port; containers use 8080.
# For native/Homebrew startup use NODO_LISTEN instead (see the native section).
# NODO_ALLOW_REGISTRATION: 1 shows Create an account and permits new signups;
# 0 (default) disables public signup. The first account can always complete setup.
# NODO_SECURE_COOKIE: 0 for local HTTP; use 1 when accessing the app over HTTPS.
# NODO_CONNECTOR_HOSTS adds comma-separated HTTPS hostnames, without scheme/path,
# e.g. github.company.example,devops.company.example. Empty keeps built-in hosts.
# RUST_LOG controls server logging; the default is rightcommit=info.
RIGHTCOMMIT_PORT=8080
NODO_ALLOW_REGISTRATION=0
NODO_SECURE_COOKIE=0
NODO_CONNECTOR_HOSTS=
RUST_LOG=rightcommit=info

# Native startup only (uncomment only when running the binary outside Docker).
# Native startup reads .env in the launch directory; existing environment wins.
# Docker already fixes its data, source, asset and listen paths and enables Linux
# user isolation. These examples do not override those container settings.
# NODO_DATA=./data
# NODO_SOURCES=./sources
# NODO_ASSETS=/absolute/path/to/installed/resources
# NODO_LISTEN=127.0.0.1:8080
# NODO_ISOLATE_USERS=0
# NODO_ISOLATE_USERS=1 requires Linux and the privileges used by the Docker image.

# ============================================================================
# OpenAI and Codex
# ============================================================================
# Fill only the credentials/mode you use; leave other entries empty.
# CODEX_API_KEY / OPENAI_API_KEY are API credentials. CODEX_ACCESS_TOKEN is an
# optional existing Codex access token; it does not initiate an OAuth login.
OPENAI_API_KEY=
CODEX_API_KEY=
CODEX_ACCESS_TOKEN=
OPENAI_BASE_URL=

# ============================================================================
# Claude / Anthropic: authentication and gateway
# ============================================================================
# API keys, an authorized gateway bearer token, or an existing Claude OAuth
# token are alternatives. Read PROVIDER_TERMS.md before sharing organization access.
# Provider environment credentials are administrator-scoped; other users configure
# their own credentials or native login in Personal Settings.
# ANTHROPIC_OAUTH_TOKEN is retained for compatibility/redaction; the Claude login
# token consumed by the launcher is CLAUDE_CODE_OAUTH_TOKEN.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_OAUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_CUSTOM_HEADERS=

# ============================================================================
# Claude models and runtime options
# ============================================================================
# Optional native CLI model/gateway settings; empty preserves native defaults.
# Compaction is controlled by Personal Settings. CLAUDE_AUTOCOMPACT_PCT_OVERRIDE
# is a compatibility setting and is overridden by the app's compaction policy.
ANTHROPIC_MODEL=
ANTHROPIC_BETAS=
API_TIMEOUT_MS=
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL_NAME=
ANTHROPIC_DEFAULT_SONNET_MODEL_NAME=
ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME=
CLAUDE_AUTOCOMPACT_PCT_OVERRIDE=

# ============================================================================
# AWS: Bedrock, Mantle and Anthropic AWS
# ============================================================================
# Select at most one Claude cloud provider mode (AWS, Vertex or Foundry).
# AWS values are also used by Pi Bedrock and native Codex AWS profiles.
# Credential/profile file paths must exist and be readable inside the container;
# setting a path here does not mount the corresponding host file.
CLAUDE_CODE_USE_BEDROCK=
CLAUDE_CODE_USE_MANTLE=
CLAUDE_CODE_USE_ANTHROPIC_AWS=
AWS_REGION=
AWS_DEFAULT_REGION=
AWS_BEARER_TOKEN_BEDROCK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=
AWS_CONFIG_FILE=
AWS_SHARED_CREDENTIALS_FILE=
AWS_WEB_IDENTITY_TOKEN_FILE=
AWS_ROLE_ARN=
AWS_ROLE_SESSION_NAME=
ANTHROPIC_BEDROCK_BASE_URL=
ANTHROPIC_BEDROCK_MANTLE_BASE_URL=
ANTHROPIC_BEDROCK_REGION_PREFIX=
CLAUDE_CODE_SKIP_BEDROCK_AUTH=
ANTHROPIC_AWS_API_KEY=
ANTHROPIC_AWS_BASE_URL=
ANTHROPIC_AWS_WORKSPACE_ID=
AWS_CONTAINER_AUTHORIZATION_TOKEN=
AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE=
AWS_CONTAINER_CREDENTIALS_FULL_URI=
AWS_CONTAINER_CREDENTIALS_RELATIVE_URI=

# ============================================================================
# Google Cloud / Vertex AI
# ============================================================================
# Claude Vertex mode and shared Google/Pi credentials.
# File paths refer to the container filesystem when using Docker.
CLAUDE_CODE_USE_VERTEX=
CLAUDE_CODE_SKIP_VERTEX_AUTH=
ANTHROPIC_VERTEX_PROJECT_ID=
ANTHROPIC_VERTEX_BASE_URL=
CLOUD_ML_REGION=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GCLOUD_PROJECT=
GOOGLE_OAUTH_ACCESS_TOKEN=
GOOGLE_CLOUD_API_KEY=
GOOGLE_CLOUD_LOCATION=

# ============================================================================
# Azure / Foundry and Azure OpenAI
# ============================================================================
# Claude Foundry mode, Azure identity and Pi Azure OpenAI configuration.
# Configure only the authentication mode required by your selected provider.
CLAUDE_CODE_USE_FOUNDRY=
CLAUDE_CODE_SKIP_FOUNDRY_AUTH=
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_AUTH_TOKEN=
ANTHROPIC_FOUNDRY_RESOURCE=
ANTHROPIC_FOUNDRY_BASE_URL=
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
AZURE_CLIENT_CERTIFICATE_PATH=
AZURE_FEDERATED_TOKEN_FILE=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_DEPLOYMENT_NAME_MAP=
AZURE_OPENAI_RESOURCE_NAME=

# ============================================================================
# Local Pi endpoint
# ============================================================================
# Endpoint URL must be reachable from the app container (localhost inside Docker
# refers to that container). An optional key is used only by the local provider.
PI_LOCAL_BASE_URL=
PI_LOCAL_API_KEY=

# ============================================================================
# Additional Pi providers and authorized gateways
# ============================================================================
# Only variables for the selected provider are forwarded to Pi.
# Leave unused providers empty. Provider/model selection lives in Personal Settings.
# Anthropic organization/federation fields below are for the selected Pi provider.
XAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=
ANTHROPIC_FEDERATION_RULE_ID=
ANTHROPIC_IDENTITY_TOKEN_FILE=
ANTHROPIC_ORGANIZATION_ID=
ANTHROPIC_SERVICE_ACCOUNT_ID=
ANTHROPIC_WORKSPACE_ID=
ANT_LING_API_KEY=
BASETEN_API_KEY=
CEREBRAS_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=
CLOUDFLARE_GATEWAY_ID=
COPILOT_GITHUB_TOKEN=
FIREWORKS_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
HF_TOKEN=
KIMI_API_KEY=
META_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
NVIDIA_API_KEY=
OPENCODE_API_KEY=
QWEN_TOKEN_PLAN_API_KEY=
QWEN_TOKEN_PLAN_CN_API_KEY=
RADIUS_API_KEY=
TOGETHER_API_KEY=
XIAOMI_API_KEY=
XIAOMI_TOKEN_PLAN_AMS_API_KEY=
XIAOMI_TOKEN_PLAN_CN_API_KEY=
XIAOMI_TOKEN_PLAN_SGP_API_KEY=
ZAI_API_KEY=
ZAI_CODING_CN_API_KEY=

# ============================================================================
# TypeSafe classifier
# ============================================================================
# Classifier models, not a chat provider.
TYPESAFE_API_KEY=

# ============================================================================
# Network proxies and trusted certificates
# ============================================================================
# Optional proxy URLs and certificate files. Paths must exist inside the container.
# Empty certificate entries preserve the system CA store. Docker Compose supplies
# /etc/ssl/certs/ca-certificates.crt and /etc/ssl/certs as SSL defaults.
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=
NODE_EXTRA_CA_CERTS=
SSL_CERT_FILE=
SSL_CERT_DIR=
CODEX_CA_CERTIFICATE=
